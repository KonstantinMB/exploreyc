# =============================================================================
# Backend environment variables (copy to .env in repo root for local dev)
# =============================================================================

# --- Database ---------------------------------------------------------------
# Local dev: leave DATABASE_URL unset to use SQLite at backend/database.db
# Production (Supabase): use the "Connection pooling" URI (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Direct/session connection (port 5432) — required for migrations & long-running DDL.
# Copy DATABASE_URL and change :6543 to :5432.
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_KEY=your-supabase-service-role-key

# --- Admin dashboard --------------------------------------------------------
# Generate strong random values — these protect /api/admin/* routes.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me

# --- LLM / research providers ----------------------------------------------
# Required for /api/validate-idea and embedding generation.
OPENAI_API_KEY=sk-your-openai-key

# Optional. Used by /api/research and Perplexity-backed enrichment.
PERPLEXITY_API_KEY=pplx-your-perplexity-key

# Optional. Used by funding/people enrichment via CoreSignal.
CORESIGNAL_API_KEY=your-coresignal-key

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=re_your-resend-api-key

# --- Stripe billing (Public API plan subscriptions) --------------------------
# Optional — with STRIPE_SECRET_KEY unset, billing endpoints return 503 and the
# rest of the app is unaffected. Webhook endpoint: POST /api/stripe/webhook
# (point a Stripe dashboard webhook at the backend, events: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted).
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# Recurring monthly price IDs created in the Stripe dashboard.
STRIPE_PRICE_PRO=price_pro-50usd-month
STRIPE_PRICE_MAX=price_max-500usd-month

# --- Rate limiting (optional) ------------------------------------------------
# If unset, the API falls back to an in-memory per-process limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App / cron -------------------------------------------------------------
# Frontend origin (used for CORS + email links). Use http://localhost:5173 locally.
FRONTEND_URL=http://localhost:5173

# Shared secret required as a Bearer token on /api/cron/* endpoints.
CRON_SECRET=generate-a-long-random-string

# --- ExploreYC World audience (optional) ------------------------------------
# Real platform reach for GET /api/world/audience — the "N visitors in the last
# 30 days, from N countries" line on /world, the homepage World section and the
# stake modal. Read from the Vercel Web Analytics REST API; collection is
# already live because the frontend ships @vercel/analytics.
#
# ALL THREE UNSET IS A SUPPORTED STATE: the endpoint returns null for every
# traffic figure and those lines are omitted from the UI. Nothing is ever
# substituted, estimated or rounded up — the only alternative to a real number
# here is no number.
#
# Token: https://vercel.com/account/settings/tokens ("Create Token"; scope it to
# the team that owns the project, read access is enough). Web Analytics must be
# enabled on the project. Project/team ids: Vercel dashboard -> Project ->
# Settings -> General ("Project ID"), and Team -> Settings -> General ("Team
# ID"); both are also in .vercel/project.json after `vercel link`.
# VERCEL_TEAM_ID is required for a project owned by a team, which is the usual case.
#
# Refreshed by POST /api/cron/refresh-world-audience and by the nightly
# /api/cron/daily-scrape. The public endpoint only ever reads the cached row.
VERCEL_ANALYTICS_TOKEN=
VERCEL_PROJECT_ID=prj_your-project-id
VERCEL_TEAM_ID=team_your-team-id

# --- Multi-source sync (optional) ------------------------------------------
# Product Hunt developer token — enables the Product Hunt source in the daily
# sync. Create one at https://www.producthunt.com/v2/oauth/applications
# ("Create Token"). Absent => Product Hunt is skipped (Hacker News still syncs).
PH_TOKEN=your-product-hunt-developer-token

# =============================================================================
# Docker Compose
# =============================================================================
# DATABASE_URL is set automatically by docker-compose.yml — don't set it here
# for the Docker workflow. Override other vars by adding them to a .env file.
VITE_API_BASE_URL=http://backend:8000
